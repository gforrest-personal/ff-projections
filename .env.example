# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored, so your secrets stay off GitHub.

# Season to pull projections for (optional; defaults to 2026).
SEASON=2026

# --- ESPN ---
# Your ESPN fantasy league ID (the number in the league URL).
ESPN_LEAGUE_ID=123456789
# Auth cookies for a PRIVATE ESPN league. Log in at espn.com, then read them
# from your browser's cookies (DevTools > Application > Cookies). See README.
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=your_long_espn_s2_cookie_value_here

# --- Yahoo ---
# Your Yahoo fantasy league ID (the number in the league URL).
YAHOO_LEAGUE_ID=1234567
# NOTE: Yahoo also needs a full browser session cookie, which goes in a separate
# file named `yahoo_cookies.txt` (also git-ignored). See README for how to grab it.
