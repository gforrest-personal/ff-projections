# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored, so your secrets stay off GitHub.
# Sleeper and ESPN need no configuration; only Yahoo does.

# Season to pull projections for (optional; defaults to 2026).
SEASON=2026

# --- Yahoo ---
# Your Yahoo fantasy league ID (the number in the league URL). The league must
# use half-PPR scoring (0.5 points per reception). See README.
YAHOO_LEAGUE_ID=1234567
# NOTE: Yahoo also needs a full browser session cookie, which goes in a separate
# file named `yahoo_cookies.txt` (also git-ignored). See README for how to grab it.
